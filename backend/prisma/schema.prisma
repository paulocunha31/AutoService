generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id          Int      @id @default(autoincrement())
  nome        String
  cnpj        String   @unique
  email       String   @unique
  telefone    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}